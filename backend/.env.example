DATABASE_URL="postgresql://expensesnap:expensesnap_dev@localhost:5432/expensesnap?schema=public"
PORT=3000
JWT_ACCESS_SECRET="change-me-access-secret-with-at-least-32-characters"
JWT_REFRESH_SECRET="change-me-refresh-secret-with-at-least-32-characters"
FRONTEND_ORIGIN="http://localhost:5173"
UPLOAD_DIR="uploads"
TRUST_PROXY_HOPS=0
RECEIPT_QUOTA_MB_PER_USER=100
RECEIPT_TOTAL_QUOTA_MB=500
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300

# Open Banking (somente leitura / AIS). Desligado por omissão.
# Nunca ativar sem backup verificado da base de dados.
OPEN_BANKING_ENABLED=false
# fake = adaptador de testes (sem rede); enable_banking = integração real/sandbox.
OPEN_BANKING_PROVIDER=fake
OPEN_BANKING_DEFAULT_COUNTRY=PT
# URL público e absoluto do callback. Tem de terminar em /api/open-banking/callback,
# sem query nem fragmento, e tem de ser exatamente o URL registado no provedor.
OPEN_BANKING_CALLBACK_URL=
# base64 de exatamente 32 bytes (chave AES-256). Gerar com: openssl rand -base64 32
OPEN_BANKING_DATA_KEY_B64=
# Segredo do agendamento interno (mínimo 32 caracteres).
OPEN_BANKING_CRON_SECRET=
OPEN_BANKING_SYNC_INTERVAL_MINUTES=360
ENABLE_BANKING_ENV=sandbox
ENABLE_BANKING_APP_ID=
# Chave privada RSA (PEM) em base64, usada só no backend para assinar o JWT da app.
ENABLE_BANKING_PRIVATE_KEY_B64=
