generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String
  currency        String    @default("EUR")
  timeZone        String    @default("Europe/Lisbon")
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  expenses         Expense[]
  incomes          Income[]
  accounts         Account[]
  transfers        Transfer[]
  categories       Category[]
  budgets          Budget[]
  savingsGoals     SavingsGoal[]
  recurringExpenses RecurringExpense[]
  recurringIncomes RecurringIncome[]
  debts            Debt[]
  notes            FinancialNote[]
  refreshTokens    RefreshToken[]
  verificationToken EmailVerificationToken?
  passwordResetToken PasswordResetToken?
  financialProfile FinancialProfile?

  bankConnections         BankConnection[]
  bankAuthorizationAttempts BankAuthorizationAttempt[]
  bankTransactions        BankTransaction[]
  bankSyncJobs            BankSyncJob[]
}

enum FinancialGoal {
  emergency_fund
  debt_repayment
  home_purchase
  major_purchase
  education
  retirement
  wealth_growth
  other
}

enum FinancialHorizon {
  short_term
  medium_term
  long_term
}

enum FinancialExperience {
  none
  beginner
  intermediate
  advanced
}

enum RiskTolerance {
  conservative
  moderate
  aggressive
}

model FinancialProfile {
  id                    String              @id @default(uuid())
  userId                String              @unique
  monthlyNetIncome      Decimal             @db.Decimal(12, 2)
  monthlyEssentialCosts Decimal             @db.Decimal(12, 2)
  monthlyHousingCosts   Decimal             @db.Decimal(12, 2)
  monthlyDebtPayments   Decimal             @db.Decimal(12, 2)
  currentSavings        Decimal             @db.Decimal(12, 2)
  goal                  FinancialGoal
  horizon               FinancialHorizon
  experience            FinancialExperience
  riskTolerance         RiskTolerance
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String  @id @default(uuid())
  name      String
  icon      String?
  isDefault Boolean @default(false)
  userId    String

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  budgets        Budget[]
  financialNotes FinancialNote[]
  recurringExpenses RecurringExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Expense {
  id              String   @id @default(uuid())
  userId          String
  categoryId      String
  accountId       String?
  description     String
  location        String
  amount          Decimal  @db.Decimal(10, 2)
  date            DateTime
  // Legacy filesystem path. New uploads are stored in PostgreSQL so they
  // survive stateless web-service restarts and deploys.
  receiptImageUrl String?
  receiptData     Bytes?   @db.ByteA
  receiptMimeType String?
  receiptFileName String?
  receiptFileSize Int?
  // Legacy nullable column kept for backwards-compatible databases. The app never writes or reads it.
  ocrRawText      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account  Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  // Movimento bancário que originou esta despesa, quando existir.
  bankTransaction BankTransaction?

  @@index([userId, date])
  @@index([userId, categoryId, date])
  @@index([userId, accountId, date])
}

model Budget {
  id           String  @id @default(uuid())
  userId       String
  categoryId   String
  monthlyLimit Decimal @db.Decimal(10, 2)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, categoryId])
  @@index([categoryId])
}

model Income {
  id          String   @id @default(uuid())
  userId      String
  accountId   String?
  description String
  source      String?
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  // Movimento bancário que originou este rendimento, quando existir.
  bankTransaction BankTransaction?

  @@index([userId, date])
  @@index([userId, accountId, date])
}

model SavingsGoal {
  id            String    @id @default(uuid())
  userId        String
  name          String
  icon          String?
  targetAmount  Decimal   @db.Decimal(12, 2)
  currentAmount Decimal   @default(0) @db.Decimal(12, 2)
  targetDate    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, targetDate])
}

model RecurringExpense {
  id          String   @id @default(uuid())
  userId      String
  categoryId  String
  accountId   String?
  description String
  location    String
  amount      Decimal  @db.Decimal(10, 2)
  dayOfMonth  Int
  nextDueDate DateTime
  isActive    Boolean  @default(true)
  lastPaidAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account  Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, isActive, nextDueDate])
  @@index([userId, categoryId])
  @@index([userId, accountId])
}

enum AccountType {
  current
  savings
  cash
  credit_card
  other
}

enum AccountSource {
  // Conta criada pelo utilizador: o saldo é derivado dos movimentos.
  manual
  // Conta ligada por Open Banking: o saldo vem do provedor.
  bank
}

model Account {
  id              String        @id @default(uuid())
  userId          String
  name            String
  type            AccountType
  openingBalance  Decimal       @default(0) @db.Decimal(12, 2)
  creditLimit     Decimal?      @db.Decimal(12, 2)
  source          AccountSource @default(manual)
  currency        String        @default("EUR")
  // Snapshots do saldo fornecido pelo banco. São a fonte principal enquanto a
  // conta estiver ligada; nunca se somam aos movimentos derivados.
  providerCurrentBalance   Decimal?   @db.Decimal(12, 2)
  providerAvailableBalance Decimal?  @db.Decimal(12, 2)
  providerBalanceUpdatedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  incomes           Income[]
  recurringExpenses RecurringExpense[]
  recurringIncomes  RecurringIncome[]
  outgoingTransfers Transfer[]         @relation("TransferFrom")
  incomingTransfers Transfer[]         @relation("TransferTo")
  bankAccountLink   BankAccountLink?

  @@unique([userId, name])
  @@index([userId, type])
}

model Transfer {
  id            String   @id @default(uuid())
  userId        String
  fromAccountId String
  toAccountId   String
  amount        Decimal  @db.Decimal(12, 2)
  description   String?
  date          DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount Account @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   Account @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  // Movimentos bancários que originaram esta transferência entre contas próprias.
  bankTransactions BankTransaction[]

  @@index([userId, date])
  @@index([fromAccountId, date])
  @@index([toAccountId, date])
}

model RecurringIncome {
  id          String   @id @default(uuid())
  userId      String
  accountId   String?
  description String
  source      String?
  amount      Decimal  @db.Decimal(12, 2)
  dayOfMonth  Int
  nextDueDate DateTime
  isActive    Boolean  @default(true)
  lastReceivedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, isActive, nextDueDate])
  @@index([userId, accountId])
}

model Debt {
  id              String   @id @default(uuid())
  userId          String
  name            String
  lender          String
  currentBalance  Decimal  @db.Decimal(12, 2)
  annualInterestRate Decimal @default(0) @db.Decimal(5, 2)
  monthlyPayment  Decimal  @db.Decimal(12, 2)
  nextPaymentDate DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextPaymentDate])
}

// Legacy table kept so existing installations do not lose data during this scope change.
// No route or service accesses it; the product does not generate financial notes.
model FinancialNote {
  id                String   @id @default(uuid())
  userId            String
  content           String
  severity          String
  relatedCategoryId String?
  createdAt         DateTime @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedCategory Category? @relation(fields: [relatedCategoryId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([relatedCategoryId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Um único token de verificação ativo por utilizador; reenviar substitui-o.
// Apenas o hash SHA-256 é guardado, à semelhança dos refresh tokens.
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// Um único token de reposição ativo por utilizador; um novo pedido substitui-o.
// Só o hash SHA-256 é guardado; o valor em claro vai só no email.
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Open Banking (somente leitura / AIS).
// Nenhum modelo guarda palavra-passe, credencial bancária ou IBAN completo.
// ---------------------------------------------------------------------------

enum BankProvider {
  enable_banking
  fake
}

enum BankConnectionStatus {
  pending
  active
  reauth_required
  expired
  revoked
  disconnected
  error
}

enum BankTransactionStatus {
  pending
  booked
  rejected
  removed
}

enum BankTransactionDirection {
  debit
  credit
}

enum BankTransactionClassification {
  unreviewed
  expense
  income
  internal_transfer
  ignored
  refund
}

enum BankSyncJobStatus {
  queued
  running
  completed
  partial
  failed
}

enum BankSyncTrigger {
  initial
  manual
  scheduled
  reauthorization
}

// Tentativa de autorização: guarda apenas o hash do state, nunca o state em si.
model BankAuthorizationAttempt {
  id                      String       @id @default(uuid())
  userId                  String
  provider                BankProvider
  institutionId           String
  institutionName         String
  country                 String
  psuType                 String
  stateHash               String       @unique
  providerAuthorizationId String?
  // Ligação que está a ser renovada (ausente numa autorização inicial).
  connectionId            String?
  // Validado contra uma allowlist interna; impede open redirect no callback.
  returnPath              String
  expiresAt               DateTime
  usedAt                  DateTime?
  createdAt               DateTime     @default(now())

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection BankConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([connectionId])
}

model BankConnection {
  id        String       @id @default(uuid())
  userId    String
  provider  BankProvider
  // Identificador de sessão do provedor, cifrado em repouso (AES-256-GCM).
  providerSessionCiphertext String
  institutionId       String
  institutionName     String
  institutionCountry  String
  status              BankConnectionStatus
  consentExpiresAt    DateTime?
  lastSyncedAt        DateTime?
  nextSyncAt          DateTime?
  lastErrorCode       String?
  lastErrorAt         DateTime?
  disconnectedAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts  BankAccountLink[]
  syncJobs  BankSyncJob[]
  authorizationAttempts BankAuthorizationAttempt[]

  @@index([userId, status])
  @@index([status, nextSyncAt])
}

model BankAccountLink {
  id        String @id @default(uuid())
  connectionId String
  accountId String @unique
  // Identificador da conta no provedor, cifrado em repouso.
  providerAccountIdCiphertext String
  // Hash estável da conta, usado para casar a mesma conta entre sessões.
  providerAccountHash         String
  displayName     String
  // Apenas para apresentação; o IBAN completo nunca é guardado.
  maskedIban      String?
  // HMAC do IBAN normalizado, quando o provedor o devolve. Permite casar
  // transferências entre contas próprias sem guardar o IBAN.
  providerIbanHash String?
  currency        String
  accountType     String
  lastTransactionSyncAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  connection   BankConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@unique([connectionId, providerAccountHash])
  @@index([connectionId])
  @@index([providerIbanHash])
}

model BankTransaction {
  id            String @id @default(uuid())
  userId        String
  bankAccountLinkId String
  // Referência estável do provedor (entry_reference), quando existir.
  providerEntryReference String?
  // Identificador não estável; nunca usar como chave lógica.
  providerTransactionId  String?
  dedupeKey     String
  status        BankTransactionStatus
  direction     BankTransactionDirection
  // Montante sempre positivo; o sentido está em `direction`.
  amount        Decimal @db.Decimal(12, 2)
  currency      String
  bookingDate   DateTime?
  valueDate     DateTime?
  transactionDate DateTime?
  description   String
  counterpartyName String?
  counterpartyAccountHash String?
  merchantCategoryCode String?
  bankTransactionCode String?
  classification BankTransactionClassification @default(unreviewed)
  excludedFromAnalytics Boolean @default(false)
  expenseId     String? @unique
  incomeId      String? @unique
  transferId    String?
  // Payload de diagnóstico, cifrado e com política de retenção.
  rawDataEncrypted Bytes?
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccountLink BankAccountLink  @relation(fields: [bankAccountLinkId], references: [id], onDelete: Cascade)
  expense         Expense?         @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  income          Income?          @relation(fields: [incomeId], references: [id], onDelete: SetNull)
  transfer        Transfer?        @relation(fields: [transferId], references: [id], onDelete: SetNull)

  @@unique([bankAccountLinkId, dedupeKey])
  @@index([userId, status, bookingDate])
  @@index([userId, classification, bookingDate])
  @@index([transferId])
}

model BankSyncJob {
  id          String @id @default(uuid())
  userId      String
  connectionId String
  trigger     BankSyncTrigger
  status      BankSyncJobStatus @default(queued)
  attemptCount Int @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  accountsProcessed   Int @default(0)
  transactionsCreated Int @default(0)
  transactionsUpdated Int @default(0)
  transactionsSkipped Int @default(0)
  errorCode   String?
  // Detalhe sanitizado: nunca contém payload bancário nem dados do PSU.
  errorDetailSanitized String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([connectionId, status])
}
