# PostgreSQL usado pelo Docker Compose e pelo backend em desenvolvimento.
POSTGRES_DB=expensesnap
POSTGRES_USER=expensesnap
POSTGRES_PASSWORD=expensesnap_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://expensesnap:expensesnap_dev@localhost:5432/expensesnap?schema=public

# URLs e portas locais.
PORT=3000
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api

# Substituir por segredos aleatórios antes de qualquer deploy.
JWT_ACCESS_SECRET=change-me-access-secret-with-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-with-at-least-32-characters
