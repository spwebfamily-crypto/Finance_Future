# PostgreSQL usado pelo Docker Compose e pelo backend em desenvolvimento.
POSTGRES_DB=expensesnap
POSTGRES_USER=expensesnap
POSTGRES_PASSWORD=expensesnap_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://expensesnap:expensesnap_dev@localhost:5432/expensesnap?schema=public

# URLs e portas locais.
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api

# Substituir por segredos aleatórios antes de qualquer deploy.
JWT_ACCESS_SECRET=change-me-access-secret-with-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-with-at-least-32-characters

# Open Banking (somente leitura / AIS). Desligado por omissão.
# Em produção FRONTEND_ORIGIN tem de ser a origem exata e pública do Netlify
# (https, sem caminho, sem barra final); é a única origem usada nos
# redirecionamentos depois do callback do banco.
OPEN_BANKING_ENABLED=false
OPEN_BANKING_PROVIDER=fake
OPEN_BANKING_DEFAULT_COUNTRY=PT
# URL absoluto do callback do backend (Render), terminando em /api/open-banking/callback.
OPEN_BANKING_CALLBACK_URL=
# base64 de exatamente 32 bytes. Gerar com: openssl rand -base64 32
OPEN_BANKING_DATA_KEY_B64=
OPEN_BANKING_CRON_SECRET=
OPEN_BANKING_SYNC_INTERVAL_MINUTES=360
ENABLE_BANKING_ENV=sandbox
ENABLE_BANKING_APP_ID=
# Chave privada RSA (PEM) em base64, apenas no backend.
ENABLE_BANKING_PRIVATE_KEY_B64=
